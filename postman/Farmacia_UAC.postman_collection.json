  "item": [
    {
      "name": "01 - Productos",
      "item": [
        {
          "name": "Listar productos - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Estado es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Devuelve paginación de 10', function () {",
                  "    pm.expect(body.data).to.be.an('array');",
                  "    pm.expect(body.meta.per_page).to.eql(10);",
                  "});",
                  "",
                  "pm.test('Oculta auditorías y campos internos', function () {",
                  "    if (body.data.length === 0) {",
                  "        return;",
                  "    }",
                  "",
                  "    pm.expect(body.data[0]).to.not.have.property('deleted_at');",
                  "    pm.expect(body.data[0]).to.not.have.property('created_at');",
                  "    pm.expect(body.data[0]).to.not.have.property('updated_at');",
                  "    pm.expect(body.data[0]).to.not.have.property('stock_minimo');",
                  "    pm.expect(body.data[0].categoria).to.not.have.property('created_at');",
                  "});",
                  "",
                  "if (body.data.length > 0) {",
                  "    pm.collectionVariables.set('productoId', body.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "Crear producto - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Estado es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('No expone datos sensibles', function () {",
                  "    pm.expect(body.data).to.not.have.property('deleted_at');",
                  "    pm.expect(body.data).to.not.have.property('created_at');",
                  "    pm.expect(body.data).to.not.have.property('updated_at');",
                  "    pm.expect(body.data).to.not.have.property('stock_minimo');",
                  "});",
                  "",
                  "pm.test('Formatea el precio y la categoría', function () {",
                  "    pm.expect(body.data.precio).to.be.a('number');",
                  "    pm.expect(body.data.categoria).to.have.property('id');",
                  "});",
                  "",
                  "pm.collectionVariables.set('productoId', body.data.id);"
                ]
