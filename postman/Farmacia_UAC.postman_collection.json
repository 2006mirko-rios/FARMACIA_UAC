                  "pm.test('Estado es 422 Unprocessable Content', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('Detalla los campos inválidos', function () {",
                  "    pm.expect(body.errors).to.have.all.keys('codigo', 'nombre', 'precio_venta', 'stock_minimo', 'categoria_id');",
                  "});",
                  "",
