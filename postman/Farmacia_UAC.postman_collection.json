  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Accept: application/json en cada petición', function () {",
          "    pm.expect(pm.request.headers.get('Accept')).to.eql('application/json');",
          "});",
          "",
          "if (pm.response.code !== 204) {",
          "    pm.test('La respuesta es JSON', function () {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "    });",
          "",
          "    pm.test('No expone campos sensibles', function () {",
          "        const body = pm.response.json();",
          "        const payload = body && Object.prototype.hasOwnProperty.call(body, 'data') ? body.data : body;",
          "        const records = Array.isArray(payload) ? payload : [payload];",
          "",
          "        records.forEach(function (record) {",
          "            if (!record || typeof record !== 'object') {",
          "                return;",
          "            }",
          "",
          "            pm.expect(record).to.not.have.property('deleted_at');",
          "        });",
          "    });",
          "}"
        ]
      }
    }
